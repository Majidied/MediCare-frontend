# Backend REST API Gateway (MediCare-backend gateway-service)
NEXT_PUBLIC_API_URL=http://localhost:8080

# WebSocket / STOMP Notifications Service
NEXT_PUBLIC_NOTIFICATION_WS_URL=http://localhost:8091/ws-notifications

# Keycloak OIDC Authentication
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=medicare
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=medicare-frontend

# Stripe Checkout (Publishable Key — never commit sk_test_ / sk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
